# Copy this file to ".env" and fill in your real values.

# 1) Your Groq API key (get one free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# 2) Database.
# ---- OPTION A: quick start with SQLite (no setup). Just leave this line commented out. ----
# ---- OPTION B: PostgreSQL (recommended, meets the assignment requirement) ----
# DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/hcp_crm
