# Copy this file to ".env" and fill in your real values.

# 1) Your Groq API key (get one free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# 2) Database (MySQL).
# First create the database once:  CREATE DATABASE hcp_crm;
# Then set your connection string below (use a letters+numbers-only password).
# DATABASE_URL=mysql+pymysql://root:YOURPASSWORD@localhost:3306/hcp_crm